<!-- Vista del carrito: solo pinta las variables que prepara carritoController ($carrito, $lineas, $productos) -->
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mi carrito</title>
</head>
<body>
    <h1>Mi carrito</h1>

    <?php if (empty($lineas)): ?>
        <p>Tu carrito está vacío.</p>
    <?php else: ?>
        <table>
            <tr>
                <th>Producto</th>
                <th>Cantidad</th>
                <th>Precio</th>
                <th>Subtotal</th>
                <th></th>
            </tr>
            <?php foreach ($lineas as $linea): ?>
                <tr>
                    <td><?= htmlspecialchars($productos[$linea->getIdProducto()]->getNombre()) ?></td>
                    <td>
                        <!-- Los inputs ocultos le dicen al controlador qué hacer y con qué línea -->
                        <form action="index.php?page=carrito" method="post">
                            <input type="hidden" name="accion" value="cantidad">
                            <input type="hidden" name="id_linea" value="<?= $linea->getIdLinea() ?>">
                            <input type="number" name="cantidad" value="<?= $linea->getCantidad() ?>" min="0" style="width: 4em">
                            <input type="submit" value="Actualizar">
                        </form>
                    </td>
                    <td><?= number_format($linea->getPrecioUnitario(), 2, ',', '.') ?> €</td>
                    <td><?= number_format($linea->getSubtotal(), 2, ',', '.') ?> €</td>
                    <td>
                        <form action="index.php?page=carrito" method="post">
                            <input type="hidden" name="accion" value="quitar">
                            <input type="hidden" name="id_linea" value="<?= $linea->getIdLinea() ?>">
                            <input type="submit" value="Quitar">
                        </form>
                    </td>
                </tr>
            <?php endforeach; ?>
        </table>
        <p><strong>Total: <?= number_format($carrito->getPrecioFinal(), 2, ',', '.') ?> €</strong></p>
        <p>
            <a href="index.php?page=finalizar_compra" style="display:inline-block; background:#28a745; color:white; padding:0.6rem 1.2rem; text-decoration:none; border-radius:4px; font-weight:bold;">Finalizar compra &rarr;</a>
        </p>
    <?php endif; ?>

    <br><a href="index.php?page=productos">&larr; Seguir comprando</a>
</body>
</html>
