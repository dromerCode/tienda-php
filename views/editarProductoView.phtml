<!-- Formulario para editar un producto: $producto y $mensaje vienen de productoController -->
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar producto</title>
    <link rel="stylesheet" href="css/admin.css">
</head>
<body>
    <?php require __DIR__ . '/adminMenu.phtml'; ?>
    <div class="contenido">
        <a href="index.php?page=admin_productos">&larr; Volver</a>
        <h1>Editar producto</h1>
