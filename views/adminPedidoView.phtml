<!-- Detalle de un pedido para el admin: $factura, $cliente y $lineas vienen de adminController -->
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pedido <?= $factura->getId() ?></title>
    <link rel="stylesheet" href="css/admin.css">
</head>
<body>
    <?php require __DIR__ . '/adminMenu.phtml'; ?>
    <div class="contenido">
        <a href="index.php?page=admin">&larr; Volver</a>
