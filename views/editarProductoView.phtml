            <textarea name="descripcion" id="descripcion" rows="4"><?= htmlspecialchars($producto->getDescripcion() ?? '') ?></textarea>
            <label for="precio">Precio (€):</label>
            <input type="number" name="precio" id="precio" step="0.01" value="<?= $producto->getPrecio() ?>" required>
            <input type="submit" value="Guardar cambios">
        </form>
        <?php if ($mensaje): ?>
            <p style="color: red;"><strong><?= htmlspecialchars($mensaje) ?></strong></p>
        <?php endif; ?>
